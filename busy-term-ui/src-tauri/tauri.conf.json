{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BusyTerm",
  "version": "0.1.0",
  "identifier": "com.tianyl1984.busy-term",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BusyTerm 设置",
        "width": 380,
        "height": 560,
        "resizable": false,
        "alwaysOnTop": true,
        "center": true,
        "visible": false
      },
      {
        "label": "popover",
        "width": 280,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "resources/busy-term-daemon": "busy-term-daemon"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
